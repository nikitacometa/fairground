# Fairground dApp — local env example
# Copy to .env.local and fill in real values.

# API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3001

# WalletConnect Cloud project ID — https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_wc_project_id_here

# Algorand network: mainnet | testnet | betanet
NEXT_PUBLIC_ALGORAND_NETWORK=testnet

# Deployed CoinflipContract app ID (bigint-safe — stored as string in env)
NEXT_PUBLIC_COINFLIP_APP_ID=0
