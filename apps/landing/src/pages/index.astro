---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ActivityTicker from '../components/ActivityTicker.astro';
import VrfExplainer from '../components/VrfExplainer.astro';
import EconomyChart from '../components/EconomyChart';
import LiveStats from '../components/LiveStats';
import ProofCardDemo from '../components/ProofCardDemo';
import TermsOfFairness from '../components/TermsOfFairness.astro';
import { PLATFORM_VERSION } from '@fairground/types';
---

<BaseLayout
  title="Fairground -- Provably Fair Games on Algorand"
  description="VRF-backed coin flips on Algorand. Every outcome verifiable on-chain. Powered by Applied Blockchain VRF beacon."
>
  <Hero />

  <!-- Live protocol feed -->
  <ActivityTicker />

  <VrfExplainer />

  <!-- Ironic economy chart -->
  <section class="py-20 px-6 border-t border-stone-800">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-amber-400 mb-2 uppercase tracking-widest" data-reveal>
        How a Coin Flip Moves the Economy
      </h2>
      <p class="text-amber-400/40 text-sm mb-8 max-w-2xl" data-reveal>
        Per-epoch HEADS rate plotted against a synthetic global market index. Patterns emerge.
      </p>
      <div data-reveal style="min-height: 340px">
        <EconomyChart client:visible />
      </div>
      <p class="mt-4 text-xs text-amber-400/30 font-mono" data-reveal>
        Correlation coefficient: 0.94 &middot; Statistical significance: p &lt; 0.001 &middot; Source: this chart
      </p>
    </div>
  </section>

  <!-- Live platform stats -->
  <section class="py-16 px-6 border-t border-stone-800">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-amber-400 mb-6 uppercase tracking-widest" data-reveal>Live Stats</h2>
      <LiveStats client:load />
    </div>
  </section>

  <!-- Ironic 'classified dossier' of the contract's guarantees -->
  <TermsOfFairness />

  <!-- VRF proof card preview -->
  <section class="py-16 px-6 border-t border-stone-800">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-amber-400 mb-2 uppercase tracking-widest" data-reveal>VRF Proof Card</h2>
      <p class="text-amber-400/40 text-sm mb-6" data-reveal>
        Every flip generates a shareable PNG proof card. Verifiable by anyone on-chain.
      </p>
      <div data-reveal>
        <ProofCardDemo client:visible />
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="relative border-t border-stone-800 py-14 px-6">
    <div class="max-w-4xl mx-auto flex flex-col items-center gap-5 text-center">
      <div class="text-amber-400 font-bold text-lg tracking-[0.3em] uppercase">Fairground</div>
      <p class="text-amber-400/45 text-sm max-w-md leading-relaxed">
        Provably-fair coin flips on Algorand. The house cannot cheat. This is not a promise -- it
        is a SHA-256 constraint, enforced on-chain and verifiable by anyone, forever.
      </p>
      <div
        class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs uppercase tracking-[0.2em] text-amber-400/60"
      >
        <a href="#how-it-works" class="transition-colors hover:text-amber-400">How it Works</a>
        <a href="https://app.fairground.quest" class="transition-colors hover:text-amber-400">Play</a>
        <a
          href="https://allo.info/application/3585680948"
          target="_blank"
          rel="noopener"
          class="transition-colors hover:text-amber-400">Verify Contract</a
        >
        <a
          href="https://allo.info/application/1615566206"
          target="_blank"
          rel="noopener"
          class="transition-colors hover:text-amber-400">VRF Beacon</a
        >
        <a
          href="https://x.com/FairgroundHQ"
          target="_blank"
          rel="noopener"
          class="transition-colors hover:text-amber-400">X / Twitter</a
        >
      </div>
      <p class="text-amber-400/15 text-[10px] tracking-wide mt-1">
        &copy; 2026 Fairground &middot; Built on Algorand &middot; v{PLATFORM_VERSION}
      </p>
    </div>
  </footer>
</BaseLayout>
