---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ActivityTicker from '../components/ActivityTicker.astro';
import VrfExplainer from '../components/VrfExplainer.astro';
import EconomyChart from '../components/EconomyChart';
import LiveStats from '../components/LiveStats';
import ProofCardDemo from '../components/ProofCardDemo';
---

<BaseLayout
  title="Fairground -- Provably Fair Games on Algorand"
  description="VRF-backed coin flips on Algorand. Every outcome verifiable on-chain. Powered by Applied Blockchain VRF beacon."
>
  <Hero />

  <!-- Live protocol feed -->
  <ActivityTicker />

  <VrfExplainer />

  <!-- Ironic economy chart -->
  <section class="py-20 px-6 border-t border-stone-800">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-amber-400 mb-2 uppercase tracking-widest" data-reveal>
        How a Coin Flip Moves the Economy
      </h2>
      <p class="text-amber-400/40 text-sm mb-8 max-w-2xl" data-reveal>
        Per-epoch HEADS rate plotted against a synthetic global market index. Patterns emerge.
      </p>
      <div data-reveal style="min-height: 340px">
        <EconomyChart client:visible />
      </div>
      <p class="mt-4 text-xs text-amber-400/30 font-mono" data-reveal>
        Correlation coefficient: 0.94 &middot; Statistical significance: p &lt; 0.001 &middot; Source: this chart
      </p>
    </div>
  </section>

  <!-- Live platform stats -->
  <section class="py-16 px-6 border-t border-stone-800">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-amber-400 mb-6 uppercase tracking-widest" data-reveal>Live Stats</h2>
      <LiveStats client:load />
    </div>
  </section>

  <!-- VRF proof card preview -->
  <section class="py-16 px-6 border-t border-stone-800">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-amber-400 mb-2 uppercase tracking-widest" data-reveal>VRF Proof Card</h2>
      <p class="text-amber-400/40 text-sm mb-6" data-reveal>
        Every flip generates a shareable PNG proof card. Verifiable by anyone on-chain.
      </p>
      <div data-reveal>
        <ProofCardDemo client:visible />
      </div>
    </div>
  </section>

  <!-- Minimal footer -->
  <footer class="border-t border-stone-800 py-8 px-6 text-center text-xs text-amber-400/30">
    <p>fairground.quest -- provably fair on Algorand</p>
    <p class="mt-1">
      VRF Beacon: app ID 1615566206 --
      <a
        href="https://allo.info/application/1615566206"
        class="underline underline-offset-2"
        target="_blank"
        rel="noopener">verify on-chain</a
      >
    </p>
    <p class="mt-2 text-amber-400/20">Not available in US, UK, TH, ID, IN, BR. 18+ only. Crypto only, no fiat.</p>
  </footer>
</BaseLayout>
