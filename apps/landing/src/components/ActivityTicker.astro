---
/**
 * ActivityTicker — a seamless CSS-marquee of recent-flip events, reading as a live
 * protocol feed under the hero. Zero JS: the track is duplicated and translated -50%
 * on an infinite linear loop. Edge-masked; pauses on hover; frozen under
 * prefers-reduced-motion (global rule in global.css).
 *
 * The events are illustrative, not live data — kept plausible: VRF beacon rounds are
 * multiples of 8 (the beacon only emits on ×8 rounds), ALGO deltas match the 0.5 max bet.
 */
interface FlipEvent {
  round: number;
  side: 'HEADS' | 'TAILS';
  delta: string;
  win: boolean;
}

const EVENTS: FlipEvent[] = [
  { round: 62_184_288, side: 'HEADS', delta: '+0.98', win: true },
  { round: 62_184_320, side: 'TAILS', delta: '-0.50', win: false },
  { round: 62_184_352, side: 'HEADS', delta: '+0.98', win: true },
  { round: 62_184_400, side: 'HEADS', delta: '+0.98', win: true },
  { round: 62_184_456, side: 'TAILS', delta: '-0.50', win: false },
  { round: 62_184_488, side: 'HEADS', delta: '+0.98', win: true },
  { round: 62_184_536, side: 'TAILS', delta: '-0.50', win: false },
  { round: 62_184_592, side: 'HEADS', delta: '+0.98', win: true },
  { round: 62_184_640, side: 'TAILS', delta: '-0.50', win: false },
  { round: 62_184_688, side: 'HEADS', delta: '+0.98', win: true },
];

// Duplicate the set so the -50% translate loops seamlessly.
const TRACK = [...EVENTS, ...EVENTS];
---

<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    {
      TRACK.map((e) => (
        <span class="ticker__item">
          <span class={`ticker__dot ${e.win ? 'is-win' : 'is-loss'}`} />
          <span class="ticker__round">ROUND #{e.round.toLocaleString('en-US')}</span>
          <span class="ticker__sep">·</span>
          <span class="ticker__side">{e.side}</span>
          <span class="ticker__sep">·</span>
          <span class={e.win ? 'ticker__win' : 'ticker__loss'}>{e.delta} ALGO</span>
        </span>
      ))
    }
  </div>
</div>

<style>
  .ticker {
    overflow: hidden;
    white-space: nowrap;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in oklch, var(--color-primary) 3%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .ticker__track {
    display: inline-flex;
    align-items: center;
    gap: 2.75rem;
    padding: 0.7rem 1.4rem;
    animation: ticker-scroll 40s linear infinite;
    will-change: transform;
  }

  .ticker:hover .ticker__track {
    animation-play-state: paused;
  }

  @keyframes ticker-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .ticker__item {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  .ticker__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 9999px;
    box-shadow: 0 0 6px currentColor;
  }
  .ticker__dot.is-win {
    background: var(--color-win);
    color: var(--color-win);
  }
  .ticker__dot.is-loss {
    background: var(--color-lose);
    color: var(--color-lose);
  }

  .ticker__round {
    color: var(--color-primary);
    opacity: 0.72;
  }
  .ticker__side {
    color: var(--color-text-dim);
  }
  .ticker__sep {
    color: var(--color-text-muted);
    opacity: 0.4;
  }
  .ticker__win {
    color: var(--color-win);
  }
  .ticker__loss {
    color: var(--color-lose);
  }
</style>
