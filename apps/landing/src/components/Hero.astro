---
// Hero section -- primary CTA, VRF headline, live stats
---

<section class="relative flex flex-col items-center justify-center min-h-screen px-6 py-24 text-center overflow-hidden">
  <!-- Background glow -->
  <div class="absolute inset-0 -z-10"
    style="background: radial-gradient(ellipse 60% 50% at 50% 0%, oklch(0.78 0.18 65 / 0.08) 0%, transparent 70%);">
  </div>

  <div class="max-w-3xl mx-auto">
    <!-- Brand -->
    <div class="text-sm font-mono uppercase tracking-[0.3em] text-amber-400/50 mb-6">
      Algorand Mainnet -- VRF Beacon #{947_957_720}
    </div>

    <!-- Headline -->
    <h1 class="text-5xl md:text-7xl font-black text-amber-400 leading-none tracking-tight mb-6">
      Provably Fair.<br />
      <span class="text-amber-400/60">On-chain.</span>
    </h1>

    <!-- Subhead -->
    <p class="text-lg text-amber-400/60 max-w-xl mx-auto mb-10 leading-relaxed">
      Every outcome derived from Applied Blockchain VRF beacon output. 
      Verifiable by anyone. No house secret. No trust required.
    </p>

    <!-- CTA -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="https://app.fairground.xyz"
        class="px-8 py-4 bg-amber-500 text-stone-950 font-bold text-lg rounded-lg hover:bg-amber-400 transition-colors"
      >
        Play Coinflip
      </a>
      <a
        href="#how-it-works"
        class="px-8 py-4 border border-amber-500/30 text-amber-400 font-bold text-lg rounded-lg hover:border-amber-500/60 transition-colors"
      >
        How it Works
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-amber-400/30 animate-bounce text-xl">
    ↓
  </div>
</section>
