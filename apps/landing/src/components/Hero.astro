---
// Hero section -- primary CTA, VRF headline, signature coin toss
import AsciiTossIsland from './AsciiTossIsland.tsx';
import HeroHeadline from './HeroHeadline.tsx';
---

<section class="relative flex flex-col items-center justify-center min-h-screen px-6 py-16 text-center overflow-hidden">
  <!-- Background glow: dual-phosphor depth (primary + offset secondary) -->
  <div
    class="absolute inset-0 -z-10 ambient-drift"
    style="
      background:
        radial-gradient(ellipse 55% 40% at 50% -5%, oklch(0.78 0.18 65 / 0.14) 0%, transparent 65%),
        radial-gradient(ellipse 30% 25% at 32% 15%, oklch(0.65 0.22 65 / 0.06) 0%, transparent 60%);
    "
  >
  </div>

  <div class="max-w-3xl mx-auto">
    <!-- Brand -->
    <div class="hero-el text-sm font-mono uppercase tracking-[0.3em] text-amber-400/50 mb-5" style="--d:0ms">
      Algorand Mainnet -- VRF Beacon #{1_615_566_206}
    </div>

    <!-- Signature ASCII coin toss (physics, cycles 10 variations) -->
    <div class="hero-el mb-6 flex justify-center min-h-[24rem] sm:min-h-[22rem] items-center" style="--d:100ms">
      <AsciiTossIsland client:load />
    </div>

    <!-- Headline (per-character terminal type-on) -->
    <div class="mb-5">
      <HeroHeadline client:load />
    </div>

    <!-- Subhead -->
    <p class="hero-el text-lg text-amber-400/60 max-w-xl mx-auto mb-8 leading-relaxed" style="--d:380ms">
      Every outcome derived from on-chain VRF beacon output.
      Verifiable by anyone. No house secret, no trust required.
    </p>

    <!-- CTA -->
    <div class="hero-el flex flex-col sm:flex-row gap-4 justify-center" style="--d:500ms">
      <a
        href="https://app.fairground.quest"
        class="group fg-conic px-8 py-4 text-amber-300 font-bold text-lg tracking-wide transition-all duration-150 hover:text-amber-200 hover:shadow-[0_0_28px_oklch(0.78_0.18_65/_0.4)]"
      >
        <span class="text-amber-500/40 group-hover:text-amber-400">[</span> Play Coinflip <span class="cursor-blink text-amber-400">_</span><span class="text-amber-500/40 group-hover:text-amber-400">]</span>
      </a>
      <a
        href="#how-it-works"
        class="px-8 py-4 border border-amber-500/20 text-amber-400/80 font-bold text-lg transition-colors hover:border-amber-500/50 hover:text-amber-300"
      >
        How it Works
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 text-amber-400/30 text-xs font-mono uppercase tracking-[0.35em]"
  >
    [ scroll &darr; ]
  </div>
</section>
