---
/**
 * BaseLayout -- root layout for the Fairground landing.
 *
 * Pattern ported from cometa-farm-landing BaseLayout.astro.
 * Includes: Plausible analytics, JSON-LD, grain overlay, ember cursor trail.
 * Fonts: IBM Plex Mono (code/stats).
 */
import '../styles/global.css';
import SmoothScroll from '../components/SmoothScroll.tsx';
import FloatingCoins from '../components/FloatingCoins.tsx';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title = 'Fairground -- Provably Fair Games on Algorand',
  description = 'VRF-backed degen games. Every outcome verifiable on-chain.',
  ogImage = 'https://fairground.quest/og.png',
  canonicalUrl = 'https://fairground.quest/',
} = Astro.props;

const plausibleDomain = import.meta.env.PLAUSIBLE_DOMAIN ?? 'fairground.quest';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#0E0A07" />

    <!-- Favicons (amber coin glyph) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fairground" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@fairground_xyz" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Plausible analytics (privacy-first, no cookies).
         SRI intentionally omitted: Plausible's hosted script.js is a
         continuously-updated file whose hash changes on every deploy.
         Pinning a hash would silently break analytics on every Plausible
         release. Self-host packages/landing/../ops/plausible.conf if SRI
         is a hard requirement. -->
    <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link href="https://fonts.bunny.net/css?family=ibm-plex-mono:400,700" rel="stylesheet" />

    <!-- JSON-LD -->
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Fairground",
        "description": description,
        "url": "https://fairground.quest",
        "applicationCategory": "GameApplication",
        "operatingSystem": "Web Browser",
      })}
    </script>
  </head>
  <body class="bg-stone-950 text-amber-50 font-mono antialiased">
    <!-- Lenis inertial scroll (no-op under prefers-reduced-motion) -->
    <SmoothScroll client:load />

    <!-- Ambient drifting coin field, behind all content -->
    <div class="bg-layer">
      <FloatingCoins client:idle />
    </div>

    <!-- Grain overlay -->
    <div
      class="pointer-events-none fixed inset-0 z-50 opacity-[0.03]"
      style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"
    ></div>

    <slot />

    <!-- Scroll-reveal: mark elements with data-reveal attribute.
         The observer stamps data-reveal-init (hides them) right before
         observing so SSR/bots/no-JS always see content.
         The .revealed class restores visibility when in viewport. -->
    <script>
      (function () {
        if (typeof IntersectionObserver === 'undefined') return;

        const elements = document.querySelectorAll('[data-reveal]');
        if (!elements.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -48px 0px' },
        );

        elements.forEach((el) => {
          // Stamp attribute just before observing — SSR/bots never see this.
          el.setAttribute('data-reveal-init', '');
          observer.observe(el);
        });
      })();
    </script>

    <!-- Ember cursor trail (amber hue 55-70).
         Guarded with prefers-reduced-motion. -->
    <script>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        // Lightweight canvas ember trail -- no dependencies
        (function () {
          const canvas = document.createElement('canvas');
          canvas.style.cssText = 'position:fixed;top:0;left:0;pointer-events:none;z-index:9999;';
          document.body.appendChild(canvas);
          const ctx = canvas.getContext('2d');
          canvas.width = window.innerWidth;
          canvas.height = window.innerHeight;
          window.addEventListener('resize', () => {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
          });

          const particles: Array<{
            x: number;
            y: number;
            vx: number;
            vy: number;
            life: number;
            hue: number;
          }> = [];
          let mouse = { x: 0, y: 0 };

          document.addEventListener('mousemove', (e) => {
            mouse = { x: e.clientX, y: e.clientY };
            for (let i = 0; i < 2; i++) {
              particles.push({
                x: mouse.x,
                y: mouse.y,
                vx: (Math.random() - 0.5) * 1.5,
                vy: -Math.random() * 2 - 0.5,
                life: 1,
                hue: 55 + Math.random() * 15,
              });
            }
          });

          function animate() {
            if (ctx) {
              ctx.clearRect(0, 0, canvas.width, canvas.height);
              for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                if (!p) continue;
                p.x += p.vx;
                p.y += p.vy;
                p.life -= 0.03;
                if (p.life <= 0) {
                  particles.splice(i, 1);
                  continue;
                }
                ctx.beginPath();
                ctx.arc(p.x, p.y, 2 * p.life, 0, Math.PI * 2);
                ctx.fillStyle = `hsla(${p.hue}, 80%, 60%, ${p.life * 0.7})`;
                ctx.fill();
              }
            }
            requestAnimationFrame(animate);
          }
          animate();
        })();
      }
    </script>
  </body>
</html>
