# Fairground — environment variable reference
# Copy to .env and fill in real values. Never commit .env.
# All values validated with Zod at startup. bigint vars: Zod coerce.bigint().

# ─── Runtime ─────────────────────────────────────────────────────────────────

# development | production | test
NODE_ENV=development

# API HTTP port. Default 3010.
PORT=3010

# ─── Algorand Network ────────────────────────────────────────────────────────

# localnet | testnet | mainnet
# Default localnet — forces explicit override before any mainnet operation.
# .claude/settings.json pins ALGORAND_NETWORK=localnet so contract test iterations
# never accidentally hit mainnet.
ALGORAND_NETWORK=localnet

# Algorand node URL.
# LocalNet (AlgoKit): http://localhost:4001
# Mainnet (AlgoNode): https://mainnet-api.algonode.cloud
ALGOD_URL=http://localhost:4001

# Algorand node API token. Empty string for public AlgoNode endpoints.
# LocalNet default: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
ALGOD_TOKEN=

# Algorand indexer URL.
# LocalNet: http://localhost:8980
# Mainnet: https://mainnet-idx.algonode.cloud
INDEXER_URL=http://localhost:8980

# ─── Contracts ───────────────────────────────────────────────────────────────

# Deployed HouseTreasury contract app ID (bigint).
# Required before accepting any bets. Set after first algokit deploy.
# Mainnet: fill in post-deploy.
HOUSE_TREASURY_APP_ID=0

# Deployed CoinflipContract app ID (bigint).
# Required for POST /games/coinflip/bets.
COINFLIP_APP_ID=0

# VRF beacon app ID (bigint).
# Mainnet: 947957720 — defined as MAINNET_BEACON_APP_ID in packages/sdk/src/vrf/beacon.ts.
# Testnet: verify via algorand MCP before hardcoding (candidate: 110096026 — unverified).
# This env var overrides the SDK constant for testnet use.
VRF_BEACON_APP_ID=947957720

# ─── Game Parameters ─────────────────────────────────────────────────────────

# Minimum bet in microALGO (bigint). Default 500000 = 0.5 ALGO.
MIN_BET_MICROALGO=500000

# Maximum bet cap in microALGO (bigint). Default 500000 = 0.5 ALGO for coinflip v1.
# The HouseTreasury contract also enforces max_payout <= 1% of live balance at resolve time.
# This env var is an additional API-side soft cap.
MAX_BET_MICROALGO=500000

# Treasury auto-pause threshold in microALGO (bigint).
# Default 2000000000 = 2000 ALGO. Keeper emits PAUSE event if balance drops below.
# The contract enforces its own pause independently via emergency_pause.
TREASURY_MIN_BALANCE_MICROALGO=2000000000

# ─── Database ────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Docker Compose: postgresql://fairground:secret@fairground-db:5432/fairground
# Local dev: postgresql://fairground:secret@localhost:5432/fairground
DATABASE_URL=postgresql://fairground:secret@localhost:5432/fairground

# ─── Redis ───────────────────────────────────────────────────────────────────

# Redis connection string.
# Docker Compose: redis://fairground-redis:6379
# Local dev: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ─── Keeper ──────────────────────────────────────────────────────────────────

# House pool seeder wallet mnemonic (25 words).
# Required for keeper to sign resolve() and fund txns.
# NEVER commit to git. block-secret-commit.sh pre-commit hook guards against staging.
# Minimum balance: 2000 ALGO before any public announcement; 5000-10000 ALGO before Foundation RT.
HOUSE_SEED_WALLET_MNEMONIC=

# Keeper instance identifier. primary | standby.
# Used as the Redis SETNX keeperlock value so primary can identify itself.
# Set per Docker Compose service (see docker-compose.yml).
KEEPER_INSTANCE_ID=primary

# ─── API / Web ───────────────────────────────────────────────────────────────

# CORS allowed origins (comma-separated).
CORS_ORIGINS=https://fairground.xyz,https://app.fairground.xyz,http://localhost:3000

# WalletConnect Cloud project ID — required by @txnlab/use-wallet-react for WC v2 sessions.
# Register free at cloud.walletconnect.com.
# Injected into apps/game at build time as NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Plausible analytics domain (used in apps/landing BaseLayout.astro).
PLAUSIBLE_DOMAIN=fairground.xyz
