{
  "name": "@fairground/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "lint:check": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "hono": "4.12.23",
    "@hono/node-server": "2.0.4",
    "@hono/zod-validator": "0.8.0",
    "ioredis": "5.11.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "zod": "4.4.3",
    "ws": "8.21.0",
    "drizzle-orm": "0.45.2",
    "@fairground/db": "workspace:*",
    "@fairground/types": "workspace:*",
    "@fairground/proof-card": "workspace:*",
    "@fairground/nfd": "workspace:*",
    "@fairground/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/ws": "8.18.1",
    "tsx": "4.22.4",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
