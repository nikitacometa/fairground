{
  "name": "@fairground/keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "lint:check": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "tsx": "4.22.3",
    "ioredis": "5.11.0",
    "algosdk": "3.5.2",
    "zod": "4.4.3",
    "@fairground/db": "workspace:*",
    "@fairground/sdk": "workspace:*",
    "@fairground/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
